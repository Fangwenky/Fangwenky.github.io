MONGO_URI=mongodb://127.0.0.1:27017/dqcf_memorial
# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Comma-separated origins allowed to call the API from another site. Leave blank for same-origin only.
CORS_ORIGIN=http://localhost:3000
